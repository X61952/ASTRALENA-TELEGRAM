# ════════════════════════════════════════════════════════════
#  ASTRALENA AI — environment variables
# ════════════════════════════════════════════════════════════

# ── Telegram ────────────────────────────────────────────────
# Token from @BotFather. (This is the token that was already in the project —
# replace it if Astralena is a brand-new bot.)
TELEGRAM_BOT_TOKEN=

# ── Groq (REQUIRED: chat, image understanding, voice notes, voice replies) ──
# Get a key at https://console.groq.com  (starts with gsk_)
GROQ_API_KEY=

# ── Owner ───────────────────────────────────────────────────
# Your numeric Telegram ID (message @userinfobot to get it). Comma-separate for several owners.
# The owner can use /chatbot train, /chatbot voice, /chatbot on all|off all.
OWNER_ID=

# ── Identity (what Astralena says about herself) ────────────
ASTRALENA_CREATOR=
ASTRALENA_RELEASED_ON=

# ── Behaviour ───────────────────────────────────────────────
# Seconds Astralena "thinks" before answering (DM shows "Astralena is thinking")
THINK_SECONDS=
# How many messages of memory are kept per chat
MAX_HISTORY=
# Seconds to wait for the AI
REQUEST_TIMEOUT=
# Inline mode: how long to wait after you stop typing before answering (milliseconds)
INLINE_DEBOUNCE_MS=
# JSON database file (created automatically)
DB_PATH=

# ── Voice (FEMALE) ──────────────────────────────────────────
# Groq Orpheus female voices: hannah, diana, autumn
TTS_VOICE=
# Free fallback voice (Microsoft Edge, no key needed)
EDGE_VOICE=

# ── Image tools ─────────────────────────────────────────────
# Background-removal API
REMOVEBG_API=
# Optional: OCR.space key for the "scan image" tool. Leave empty to let the Groq vision model read the text.
OCRSPACE_API_KEY=

# ── Website screenshots ─────────────────────────────────────
# Optional custom screenshot service. Use {url} (and {full}) as placeholders, e.g.
# SCREENSHOT_API=https://my-screenshot-service.com/shot?url={url}&full={full}
# Leave empty to use the built-in free services.
SCREENSHOT_API=

# ── Space tools ─────────────────────────────────────────────
# Optional: your own NASA API key (https://api.nasa.gov) for /apod. Leave empty to use the shared demo key.
NASA_API_KEY=

# ── Optional: real browser for screen recording and sharper screenshots ──
# Only needed if you installed puppeteer-core. Path to a Chrome/Chromium binary on the server.
# CHROME_PATH=/usr/bin/chromium

# ── Astralena's own sticker packs (short names from t.me/addstickers/<NAME>, comma separated) ──
# When someone sends a sticker, Astralena first answers with a random one from these packs.
# Empty = she skips the sticker reply and goes straight to "what should I do with it?".
STICKER_PACKS=

# ── Agent, search and limits ────────────────────────────────
# on = Astralena decides for herself when to use tools (search, links, reminders, files...). off = plain chat only.
AGENT=
# Better web search (optional, free tiers): https://tavily.com or https://brave.com/search/api
# Without a key she uses DuckDuckGo, then Wikipedia.
TAVILY_API_KEY=
BRAVE_API_KEY=
# Optional remote code runner (a Piston server, e.g. https://your-piston-host/api/v2). Empty = code running is off.
PISTON_URL=
# Messages per person per day, 0 = unlimited (the owner is never limited)
DAILY_LIMIT=
# Heavy tools (scrape, record, downloads, image generation) per person per hour
HEAVY_LIMIT_HOURLY=
# Send errors to the owner in Telegram (on or off)
ALERTS=
# Group warnings before an automatic 24 hour mute
WARN_LIMIT=

# ── Optional model overrides (comma separated, first one that works is used) ──
# GROQ_CHAT_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_SEARCH_MODEL=groq/compound-mini
# GROQ_VISION_MODELS=qwen/qwen3.8-27b,meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_WHISPER_MODELS=whisper-large-v3-turbo,whisper-large-v3
